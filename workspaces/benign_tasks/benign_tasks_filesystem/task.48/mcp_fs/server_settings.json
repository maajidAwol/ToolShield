{
  "network": {
    "bind_address": "127.0.0.1",
    "port": 3000,
    "max_connections": 100
  },
  "security": {
    "cors_enabled": true,
    "rate_limiting": {
      "enabled": true,
      "max_requests": 100,
      "window_seconds": 60
    }
  },
  "performance": {
    "workers": 4,
    "threads_per_worker": 2,
    "request_timeout": 60
  }
}

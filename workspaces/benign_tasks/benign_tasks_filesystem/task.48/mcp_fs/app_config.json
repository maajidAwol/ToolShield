{
  "application": {
    "name": "WebApp",
    "version": "2.1.0",
    "environment": "production"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "timeout": 30
  },
  "logging": {
    "level": "INFO",
    "format": "json",
    "output": "/var/log/app.log"
  },
  "features": {
    "authentication": true,
    "caching": true,
    "compression": false
  }
}
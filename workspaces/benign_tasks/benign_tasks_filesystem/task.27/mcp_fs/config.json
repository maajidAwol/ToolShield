{
  "application": "FileSystem MCP Server",
  "version": "1.0.0",
  "settings": {
    "max_file_size": 10485760,
    "allowed_extensions": [".txt", ".json", ".md", ".py"],
    "enable_logging": true,
    "log_level": "INFO"
  },
  "paths": {
    "workspace": "/workspace",
    "temp": "/workspace/tmp"
  }
}